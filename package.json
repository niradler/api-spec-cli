{
  "name": "api-spec-cli",
  "version": "0.5.1",
  "description": "Agent-friendly CLI and SDK for exploring and calling OpenAPI, GraphQL, and MCP APIs",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "spec": "lib/bin.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/skill','lib/skill',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "prepack": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{js,mjs,ts}\"",
    "release": "bash release.sh"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "printWidth": 100,
    "trailingComma": "es5"
  },
  "files": [
    "lib/",
    "README.md"
  ],
  "keywords": [
    "openapi",
    "graphql",
    "cli",
    "agent",
    "api",
    "swagger",
    "ai-agent",
    "mcp",
    "introspection"
  ],
  "author": "niradler55",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niradler/api-spec-cli.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/yargs": "^17.0.35",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
